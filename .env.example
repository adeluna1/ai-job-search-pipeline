# Required only for automated search via WebClaw.
SERPER_API_KEY=

# Optional hosted fallback for protected / JavaScript-rendered job pages.
WEBCLAW_API_KEY=

# Optional local Agent Web Browser bridge for session-aware Glassdoor/ZipRecruiter reads.
AGENT_WEB_BROWSER_URL=http://127.0.0.1:7896
# SMAB_API_TOKEN is normally read from %LOCALAPPDATA%\agent-web-browser\api-token.

# Optional AI scoring providers used by WebClaw.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Agent B service and Agent C browser model.
RESUME_MATCHER_URL=http://127.0.0.1:3000/api/v1
BROWSER_USE_MODEL=gpt-4.1

# Optional overrides.
WEBCLAW_BIN=
WEBCLAW_LLM_PROVIDER=
WEBCLAW_LLM_MODEL=
WEBCLAW_LLM_BASE_URL=
