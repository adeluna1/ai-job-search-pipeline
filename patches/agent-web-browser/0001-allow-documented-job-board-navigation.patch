--- a/src-tauri/observers/common.js
+++ b/src-tauri/observers/common.js
@@ -96,0 +97 @@
+        if (!main) return { text: '', len: 0 };
@@ -98,0 +100,60 @@
+      },
+      pageJobLinks: function () {
+        var currentHost = String(location.hostname || '').toLowerCase();
+        var board = currentHost === 'glassdoor.com' || currentHost.endsWith('.glassdoor.com')
+          ? 'glassdoor'
+          : (currentHost === 'ziprecruiter.com' || currentHost.endsWith('.ziprecruiter.com')
+            ? 'ziprecruiter'
+            : '');
+        if (!board) return { blocked: true, reason: 'active page is not a reviewed job board', links: [] };
+        var seen = {};
+        var links = [];
+        Array.prototype.forEach.call(document.querySelectorAll('a[href]'), function (anchor) {
+          try {
+            var target = new URL(anchor.href, location.href);
+            var host = String(target.hostname || '').toLowerCase();
+            var firstParty = board === 'glassdoor'
+              ? (host === 'glassdoor.com' || host.endsWith('.glassdoor.com'))
+              : (host === 'ziprecruiter.com' || host.endsWith('.ziprecruiter.com'));
+            if (target.protocol !== 'https:' || !firstParty) return;
+            var path = target.pathname.toLowerCase();
+            var isJob = board === 'glassdoor'
+              ? (path.indexOf('/job-listing/') !== -1 || target.searchParams.has('jl') || target.searchParams.has('jobListingId'))
+              : ((target.searchParams.has('jid') || target.searchParams.has('lvk')) || /^\/c\/[^/]+\/job\//i.test(target.pathname) || /^\/jobs\/[^/]+\/[^/]+/i.test(target.pathname));
+            if (!isJob) return;
+            target.hash = '';
+            var href = target.toString();
+            if (seen[href] || links.length >= 50) return;
+            seen[href] = true;
+            links.push({ href: href, text: SMAB.sanitizeForAgent((anchor.innerText || anchor.getAttribute('aria-label') || '').trim()).substring(0, 300) });
+          } catch (_) {}
+        });
+        // ZipRecruiter job cards may use client-side state instead of anchor hrefs.
+        // Read only the documented job-view key and reconstruct the current
+        // first-party search URL; never dispatch a click or inspect form data.
+        if (board === 'ziprecruiter' && links.length === 0 && document.documentElement) {
+          var html = document.documentElement.innerHTML || '';
+          var patterns = [
+            /(?:[?&]|&amp;|\\u0026)lvk(?:=|&equals;|\\u003d)([A-Za-z0-9._~-]{6,200})/g,
+            /["']lvk["']\s*:\s*["']([A-Za-z0-9._~-]{6,200})["']/g
+          ];
+          patterns.forEach(function (pattern) {
+            var match;
+            while (links.length < 50 && (match = pattern.exec(html)) !== null) {
+              try {
+                var jobView = new URL(location.href);
+                jobView.hash = '';
+                jobView.searchParams.set('lvk', match[1]);
+                var href = jobView.toString();
+                if (!seen[href]) {
+                  seen[href] = true;
+                  links.push({ href: href, text: '' });
+                }
+              } catch (_) {}
+            }
+          });
+        }
+        var pageText = ((document.body && (document.body.innerText || document.body.textContent)) || '').slice(0, 20000).toLowerCase();
+        var blocked = /(access denied|verify (you are|you're) human|captcha|unusual traffic|temporarily blocked|security check)/.test(pageText)
+          || /\/(login|signin|auth|challenge|captcha)(\/|$)/i.test(location.pathname);
+        return { board: board, blocked: blocked, reason: blocked ? 'signed-in page presented an access challenge' : '', links: links };
