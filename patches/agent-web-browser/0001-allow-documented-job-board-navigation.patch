+    // ── chrome overlay sizing ────────────────────────────────────
+    // The tab-bar webview is only 56px tall, so dropdown overlays (menus,
+    // URL editor, extensions panel) are clipped unless the host grows the
+    // webview first. expandChromeFor() asks Rust for the pixels the open
+    // overlay needs; collapseChromeIfIdle() restores the 56px strip once
+    // every overlay is closed.
+    const CHROME_H = 56;
+    async function setChromeOverlay(heightPx) {
+      try { await invoke('set_chrome_overlay', { height: Math.ceil(heightPx) }); }
+      catch (e) { console.error('set_chrome_overlay:', e); }
+    }
+    function expandChromeFor(el) {
+      const content = el ? el.offsetHeight : 0;
+      setChromeOverlay(Math.max(CHROME_H, 44 + content + 16));
+    }
+    function anyOverlayOpen() {
+      return !!document.querySelector('.menu.open')
+        || document.getElementById('ext-panel').classList.contains('open')
+        || document.getElementById('url-editor').classList.contains('open');
+    }
+    function collapseChromeIfIdle() { if (!anyOverlayOpen()) setChromeOverlay(CHROME_H); }
+
